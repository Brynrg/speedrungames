{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speedrungames.net/schemas/game-source-manifest.schema.json",
  "title": "Game source-repo manifest",
  "description": "Schema for game.manifest.json living in each game's source repo. Read by scripts/ingest-game-build.mjs.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "slug",
    "title",
    "description",
    "framework"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "minLength": 2,
      "maxLength": 48
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "entry": {
      "type": "string",
      "description": "Source entry file. Defaults to src/main.ts if absent."
    },
    "buildCommand": {
      "type": "string",
      "description": "Command to produce dist/. Defaults to 'npm run build' if absent."
    },
    "framework": {
      "type": "string",
      "enum": [
        "vite",
        "vite-phaser",
        "vite-pixi",
        "vite-react",
        "vanilla",
        "other"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "supportsMobile": {
      "type": "boolean"
    },
    "version": {
      "type": "string"
    }
  }
}
